# TEST MODE ONLY. Never put Stripe secret keys or Supabase service-role keys in a client app.
STRIPE_EXPECTED_MODE=test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_ANNUAL=price_replace_me

# Server-side only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_side_only

# Auth0 API configuration (use the exact API audience configured in Auth0)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=replace_with_auth0_api_identifier

NEXT_PUBLIC_APP_URL=https://your-test-deployment.vercel.app
